{% extends 'base.html.twig' %}

{% block title %}Owner Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12">
            <h1><i class="fas fa-tachometer-alt"></i> Owner Dashboard</h1>
            <p class="lead">Welcome back, {{ app.user.firstName }}!</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>{{ properties|length }}</h4>
                            <p>Total Properties</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-home fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>{{ properties|filter(p => p.status == 'occupied')|length }}</h4>
                            <p>Occupied Properties</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-user-check fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>{{ properties|filter(p => p.status == 'available')|length }}</h4>
                            <p>Available Properties</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-home fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>{{ properties|filter(p => p.status == 'maintenance')|length }}</h4>
                            <p>Under Maintenance</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-tools fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CHART SECTION -->
    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-pie"></i> Property Status Distribution
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="propertyStatusChart" height="250"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-bar"></i> Monthly Rental Income
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyRentChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-home"></i> My Properties
                    </h5>
                    <a href="{{ path('app_owner_property_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Add New Property
                    </a>
                </div>
                <div class="card-body">
                    {% if properties %}
                        <div class="row">
                            {% for property in properties %}
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">{{ property.address }}</h5>
                                            <h6 class="card-subtitle mb-2 text-muted">{{ property.city }}, {{ property.state }}</h6>
                                            <p class="card-text">
                                                <strong>Rent:</strong> ${{ property.monthlyRent }}/month<br>
                                                <strong>Bed/Bath:</strong> {{ property.bedrooms }}/{{ property.bathrooms }}<br>
                                                <strong>Square Feet:</strong> {{ property.squareFeet }}<br>
                                                <strong>Status:</strong>
                                                <span class="badge bg-{{ property.status == 'available' ? 'success' : (property.status == 'occupied' ? 'primary' : 'warning') }}">
                                                {{ property.status|title }}
                                            </span>
                                            </p>
                                            {% if property.manager %}
                                                <p class="card-text">
                                                    <strong>Manager:</strong> {{ property.manager.getFullName() }}
                                                </p>
                                            {% else %}
                                                <p class="card-text text-warning">
                                                    <small><i class="fas fa-exclamation-triangle"></i> No manager assigned</small>
                                                </p>
                                            {% endif %}
                                        </div>
                                        <div class="card-footer">
                                            <div class="btn-group w-100">
                                                <a href="{{ path('app_property_show', {'id': property.id}) }}" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i> View
                                                </a>
                                                <a href="{{ path('app_owner_property_edit', {'id': property.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <i class="fas fa-home fa-4x text-muted mb-3"></i>
                            <h4>No Properties Yet</h4>
                            <p class="text-muted">You haven't added any properties to your portfolio yet.</p>
                            <a href="{{ path('app_owner_property_new') }}" class="btn btn-primary btn-lg">
                                <i class="fas fa-plus"></i> Add Your First Property
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Prepare chart data from PHP variables
            const propertyStats = {
                occupied: {{ properties|filter(p => p.status == 'occupied')|length }},
                available: {{ properties|filter(p => p.status == 'available')|length }},
                maintenance: {{ properties|filter(p => p.status == 'maintenance')|length }}
            };

            // Prepare monthly rent data
            const monthlyRents = [];
            const propertyLabels = [];

            {% for property in properties %}
            monthlyRents.push({{ property.monthlyRent }});
            propertyLabels.push('{{ property.city|slice(0, 10) }}...');
            {% endfor %}

            // If no properties, create empty charts with messages
            if ({{ properties|length }} === 0) {
                createEmptyCharts();
            } else {
                // Property Status Pie Chart
                const statusCtx = document.getElementById('propertyStatusChart').getContext('2d');
                const propertyStatusChart = new Chart(statusCtx, {
                    type: 'pie',
                    data: {
                        labels: ['Occupied', 'Available', 'Maintenance'],
                        datasets: [{
                            data: [
                                propertyStats.occupied,
                                propertyStats.available,
                                propertyStats.maintenance
                            ],
                            backgroundColor: [
                                '#0d6efd', // Primary blue
                                '#198754', // Success green
                                '#fd7e14'  // Warning orange
                            ],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 20,
                                    usePointStyle: true,
                                    font: {
                                        size: 12
                                    }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = Math.round((value / total) * 100);
                                        return `${label}: ${value} properties (${percentage}%)`;
                                    }
                                }
                            }
                        }
                    }
                });

                // Monthly Rent Bar Chart (only if we have properties)
                if (monthlyRents.length > 0) {
                    const rentCtx = document.getElementById('monthlyRentChart').getContext('2d');
                    const monthlyRentChart = new Chart(rentCtx, {
                        type: 'bar',
                        data: {
                            labels: propertyLabels,
                            datasets: [{
                                label: 'Monthly Rent ($)',
                                data: monthlyRents,
                                backgroundColor: 'rgba(13, 110, 253, 0.7)',
                                borderColor: '#0d6efd',
                                borderWidth: 1,
                                borderRadius: 5
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return '$' + value;
                                        }
                                    }
                                },
                                x: {
                                    ticks: {
                                        maxRotation: 45,
                                        minRotation: 45
                                    }
                                }
                            },
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return 'Rent: $' + context.parsed.y;
                                        }
                                    }
                                },
                                legend: {
                                    display: false
                                }
                            }
                        }
                    });
                } else {
                    // If no monthly rent data, hide the chart container
                    document.getElementById('monthlyRentChart').parentElement.style.display = 'none';
                }
            }

            function createEmptyCharts() {
                const statusCtx = document.getElementById('propertyStatusChart').getContext('2d');
                const propertyStatusChart = new Chart(statusCtx, {
                    type: 'pie',
                    data: {
                        labels: ['No Properties'],
                        datasets: [{
                            data: [1],
                            backgroundColor: ['#e9ecef'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                enabled: false
                            }
                        }
                    }
                });

                const rentCtx = document.getElementById('monthlyRentChart').getContext('2d');
                const monthlyRentChart = new Chart(rentCtx, {
                    type: 'bar',
                    data: {
                        labels: ['No Data'],
                        datasets: [{
                            label: 'No Properties',
                            data: [0],
                            backgroundColor: 'rgba(233, 236, 239, 0.7)',
                            borderColor: '#e9ecef',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 1,
                                display: false
                            },
                            x: {
                                display: false
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                enabled: false
                            }
                        }
                    }
                });
            }
        });
    </script>
{% endblock %}