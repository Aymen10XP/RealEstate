{% extends 'base.html.twig' %}

{% block title %}Manager Dashboard{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12">
            <h1><i class="fas fa-tachometer-alt"></i> Manager Dashboard</h1>
            <p class="lead">Welcome back, {{ app.user.firstName }}!</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>{{ properties|length }}</h4>
                            <p>Managed Properties</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-home fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- In the manager dashboard, update the maintenance requests section -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-tools"></i> Recent Maintenance Requests
                        <a href="{{ path('app_maintenance_request_index') }}" class="btn btn-sm btn-primary float-end">
                            <i class="fas fa-list"></i> View All
                        </a>
                    </h5>
                </div>
                <div class="card-body">
                    {% if maintenance_requests %}
                        <div class="list-group">
                            {% for request in maintenance_requests|slice(0, 5) %}
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">{{ request.title }}</h6>
                                        <small class="text-{{ request.priority == 'emergency' ? 'danger' : (request.priority == 'high' ? 'warning' : 'info') }}">
                                            {{ request.priority|title }}
                                        </small>
                                    </div>
                                    <p class="mb-1">{{ request.property.address }}</p>
                                    <small>
                                        Status: <span class="badge bg-{{ request.status == 'completed' ? 'success' : (request.status == 'in_progress' ? 'primary' : 'secondary') }}">
                                    {{ request.status|replace({'_': ' '})|title }}
                                </span>
                                        | Created: {{ request.createdAt|date('M d, Y') }}
                                    </small>
                                    {% if request.status != 'completed' and request.status != 'cancelled' %}
                                        <div class="mt-2">
                                            <form action="{{ path('app_maintenance_request_done', {'id': request.id}) }}" method="post" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('done' ~ request.id) }}">
                                                <button type="submit" class="btn btn-success btn-sm"
                                                        onclick="return confirm('Mark this request as completed?')">
                                                    <i class="fas fa-check"></i> Mark Done
                                                </button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted">No maintenance requests for your properties.</p>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>{{ properties|filter(p => p.status == 'occupied')|length }}</h4>
                            <p>Occupied Properties</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-user-check fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-home"></i> My Properties
                    </h5>
                </div>
                <div class="card-body">
                    {% if properties %}
                        <div class="list-group">
                            {% for property in properties %}
                                <a href="{{ path('app_property_show', {'id': property.id}) }}" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">{{ property.address }}</h6>
                                        <small class="text-{{ property.status == 'available' ? 'success' : (property.status == 'occupied' ? 'primary' : 'warning') }}">
                                            {{ property.status|title }}
                                        </small>
                                    </div>
                                    <p class="mb-1">{{ property.city }}, {{ property.state }}</p>
                                    <small>${{ property.monthlyRent }}/month</small>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted">No properties assigned to you yet.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-tools"></i> Recent Maintenance Requests
                        <a href="{{ path('app_maintenance_request_index') }}" class="btn btn-sm btn-primary float-end">
                            <i class="fas fa-list"></i> View All
                        </a>
                    </h5>
                </div>
                <div class="card-body">
                    {% if maintenance_requests %}
                        <div class="list-group">
                            {% for request in maintenance_requests %}
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">{{ request.title }}</h6>
                                        <small class="text-{{ request.priority == 'emergency' ? 'danger' : (request.priority == 'high' ? 'warning' : 'info') }}">
                                            {{ request.priority|title }}
                                        </small>
                                    </div>
                                    <p class="mb-1">{{ request.description|slice(0, 100) }}{% if request.description|length > 100 %}...{% endif %}</p>
                                    <small>
                                        Status: <span class="badge bg-{{ request.status == 'completed' ? 'success' : (request.status == 'in_progress' ? 'primary' : 'secondary') }}">
                                        {{ request.status|replace({'_': ' '})|title }}
                                    </span>
                                        | Created: {{ request.createdAt|date('M d, Y') }}
                                    </small>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted">No maintenance requests assigned to you.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}