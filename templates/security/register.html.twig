{% extends 'base.html.twig' %}

{% block title %}Register - Real Estate Manager{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-user-plus"></i> Create Account
                    </h4>
                </div>
                <div class="card-body">
                    {{ form_start(registrationForm) }}
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(registrationForm.user_type, {
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(registrationForm.email, {
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(registrationForm.first_name, {
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(registrationForm.last_name, {
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(registrationForm.phone, {
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(registrationForm.password, {
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-user-plus"></i> Register
                        </button>
                    </div>
                    {{ form_end(registrationForm) }}

                    <div class="text-center mt-3">
                        <p>Already have an account? <a href="{{ path('app_login') }}">Login here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}