{% extends 'base.html.twig' %}

{% block title %}Maintenance Requests{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-tools"></i> Maintenance Requests
        </h1>
        {% if is_granted('ROLE_TENANT') %}
            <a href="{{ path('app_maintenance_request_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> New Request
            </a>
        {% endif %}
    </div>

    <div class="card">
        <div class="card-body">
            {% if maintenance_requests %}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                        <tr>
                            <th>Title</th>
                            <th>Property</th>
                            <th>Tenant</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Completed</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for request in maintenance_requests %}
                            <tr>
                                <td>
                                    <a href="{{ path('app_maintenance_request_show', {'id': request.id}) }}" class="text-decoration-none">
                                        {{ request.title }}
                                    </a>
                                </td>
                                <td>{{ request.property.address }}</td>
                                <td>{{ request.tenant.getFullName() }}</td>
                                <td>
                                    <span class="badge bg-{{ request.priority == 'emergency' ? 'danger' : (request.priority == 'high' ? 'warning' : (request.priority == 'medium' ? 'info' : 'secondary')) }}">
                                        {{ request.priority|title }}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-{{ request.status == 'completed' ? 'success' : (request.status == 'in_progress' ? 'primary' : (request.status == 'cancelled' ? 'danger' : 'secondary')) }}">
                                        {{ request.status|replace({'_': ' '})|title }}
                                    </span>
                                </td>
                                <td>{{ request.createdAt|date('M d, Y') }}</td>
                                <td>
                                    {% if request.completedAt %}
                                        {{ request.completedAt|date('M d, Y') }}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('app_maintenance_request_show', {'id': request.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        {% if is_granted('ROLE_MANAGER') and request.status != 'completed' and request.status != 'cancelled' %}
                                            <form action="{{ path('app_maintenance_request_done', {'id': request.id}) }}" method="post" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('done' ~ request.id) }}">
                                                <button type="submit" class="btn btn-sm btn-success"
                                                        onclick="return confirm('Mark this maintenance request as completed? The tenant will be notified.')">
                                                    <i class="fas fa-check"></i> Done
                                                </button>
                                            </form>
                                        {% endif %}

                                        {% if is_granted('ROLE_TENANT') and request.tenant == app.user and request.status != 'completed' %}
                                            <a href="{{ path('app_maintenance_request_edit', {'id': request.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info">
                    <h4 class="alert-heading">No Maintenance Requests</h4>
                    <p class="mb-0">
                        {% if is_granted('ROLE_TENANT') %}
                            You haven't submitted any maintenance requests yet.
                            <a href="{{ path('app_maintenance_request_new') }}" class="alert-link">Submit your first request</a>.
                        {% elseif is_granted('ROLE_MANAGER') %}
                            No maintenance requests for your properties at the moment.
                        {% else %}
                            No maintenance requests found.
                        {% endif %}
                    </p>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}